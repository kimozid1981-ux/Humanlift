# Copy to .env and adjust. NEVER commit a real .env file.
APP_ENV=development            # development | test | staging | production
PORT=4000
DATABASE_URL="postgresql://humanlift:humanlift@localhost:5432/humanlift_dev"
# Public URL of the web app, used in email links
WEB_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3001
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=
# Requests per minute allowed per IP on sign-in, registration and public forms
AUTH_RATE_LIMIT=10
