# Copy to deploy/.env on the server and fill in. NEVER commit the real file.

# Your domain, without https:// (the site will be https://DOMAIN, admin at https://admin.DOMAIN)
DOMAIN=example.org

# production = real public site. staging = private test copy (search engines blocked, test banner shown)
APP_ENV=production

# Long random database password. Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=

# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Keep a safe copy: if lost, staff must set up their authenticator apps again.
MFA_ENCRYPTION_KEY=

# From your email provider's SMTP settings, e.g. smtps://USERNAME:PASSWORD@smtp.provider.com:465
SMTP_URL=
# Sender address on a domain you verified with the email provider
EMAIL_FROM=HumanLift <no-reply@example.org>
